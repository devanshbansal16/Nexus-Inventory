# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection (MongoDB Atlas or Local MongoDB)
MONGO_URI=mongodb://127.0.0.1:27017/cims

# JWT Authentication Secrets
JWT_SECRET=cims_super_secure_production_jwt_secret_key_2026_xyz
JWT_REFRESH_SECRET=cims_super_secure_refresh_secret_key_2026_abc
JWT_ACCESS_EXPIRY=1d
JWT_REFRESH_EXPIRY=7d

# Redis / BullMQ (Optional: if offline, runs in direct-worker fallback mode)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# Client URL (Frontend)
CLIENT_URL=http://localhost:5173

# Python AI Forecasting Microservice
AI_SERVICE_URL=http://localhost:8000

# Cloudinary (Optional product image uploads)
CLOUDINARY_CLOUD_NAME=demo_cloud
CLOUDINARY_API_KEY=1234567890
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz
